# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- dbt generated folders (build output, installed packages, run logs) ----
/target/
/dbt_packages/
/logs/
# dbt's anonymous-usage-tracking user id, written on first run.
/.user.yml

# ---- Node / TypeScript plugin ----
node_modules/
/plugin/dist/

# ---- DuckDB warehouse ----
/warehouse/
*.duckdb
*.duckdb.wal

# ---- Raw event captures (kept as a placeholder folder, not the captures) ----
/data/raw/*
!/data/raw/.gitkeep
/data/rehearsal/
/data/company/

# ---- Converted Parquet (generated by `make convert`) ----
/data/parquet/
# Temporary folders the converter builds beside its output folder; a crash can leave one.
/data/.parquet-*/
/data/*/.parquet-*/

# ---- Install record of `make capture-data` (which plugin file it installed) ----
/data/capture/

# ---- Work folder of `make bench` (park copies, a config.ini with a private path, raw lines) ----
/data/bench/

# ---- Databases / generated data ----
*.db
*.sqlite3
# Temporary lock from `make bench-sample`.
/data/sample/*.lock

# ---- Tooling exhaust ----
# Personal per-user Claude Code overrides — never commit (may hold local grants).
.claude/settings.local.json

# ---- Local dev-server runtime ----
# Globbed to cover the previous run's log, rolled aside on each start.
*.pid
*.log
*.log.*

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Backups the probe setup/teardown scripts write before editing settings.
# A shared pattern rather than a personal one: anyone running those scripts
# generates them.
.claude/settings.json.bak.*

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Claude Code worktrees ----
# Linked worktrees created for parallel agent sessions; each has its own
# checkout and shouldn't be tracked from the main tree.
.claude/worktrees/

# Agent ticket worktrees (make ticket ID=...)
.worktrees/
# Symlinks `make ticket` makes to the main checkout's tools (a symlink is not matched by the
# directory patterns above).
.venv
node_modules

# ---- Scratch / debug artifacts ----
# Screenshots, debug images, one-shot scripts, agent handoff notes. One
# directory so the next scratch file needs no new entry here.
/scratch/

# ---- Machine-local working files ----
# Anything that is yours rather than the project's — scratch notes, run
# logs, private research — goes in `local/` and stays out of the repo.
/local/
CLAUDE.local.md
# ai-org's Resume block and log: where the work stands and its history, per machine.
docs/ai-dlc/local/
/site/_site/
