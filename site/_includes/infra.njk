{%- from "figure.njk" import figure as region -%}
{%- set F = "how-this-was-built.md" -%}
{%- set bands = [
  { id: "capture", title: "Capture" }, { id: "land", title: "Land" }, { id: "check", title: "Check" },
  { id: "model", title: "Model" }, { id: "publish", title: "Publish" }, { id: "show", title: "Show" },
  { id: "run", title: "Build and run" }
] -%}
{%- set tools = [
  { id: "openrct2", name: "OpenRCT2 0.5.6", role: "the game", band: "capture", badge: "OpenRCT2" },
  { id: "typescript", name: "TypeScript 5.9", role: "plugin", band: "capture", icon: "typescript" },
  { id: "jsonl", name: "JSONL over TCP", role: "transport", band: "capture", badge: "JSONL" },
  { id: "python", name: "Python 3.12", role: "ingest", band: "land", icon: "python" },
  { id: "parquet", name: "Parquet", role: "storage", band: "land", icon: "apacheparquet" },
  { id: "odcs", name: "ODCS contracts", role: "data quality", band: "check", badge: "ODCS" },
  { id: "sqlfluff", name: "sqlfluff", role: "SQL lint", band: "check", badge: "sqlfluff" },
  { id: "dbt", name: "dbt Core", role: "modeling", band: "model", icon: "dbt" },
  { id: "metricflow", name: "MetricFlow", role: "planned", band: "model", icon: "dbt", plan: true },
  { id: "duckdb", name: "DuckDB", role: "warehouse", band: "publish", icon: "duckdb" },
  { id: "eleventy", name: "Eleventy 3.1.6", role: "site", band: "show", icon: "eleventy" },
  { id: "plot", name: "Observable Plot", role: "charts", band: "show", icon: "observable" },
  { id: "inputs", name: "Observable Inputs", role: "planned", band: "show", icon: "observable", plan: true },
  { id: "wasm", name: "DuckDB-WASM", role: "planned", band: "show", icon: "duckdb", plan: true },
  { id: "node", name: "Node 24", role: "build", band: "run", icon: "nodedotjs" },
  { id: "uv", name: "uv", role: "environment", band: "run", icon: "uv" },
  { id: "make", name: "Make", role: "orchestration", band: "run", badge: "make" },
  { id: "actions", name: "GitHub Actions", role: "CI", band: "run", icon: "githubactions" },
  { id: "claude", name: "Claude agents", role: "builders", band: "run", icon: "claude" },
  { id: "openai", name: "OpenAI reviewers", role: "review", band: "run", icon: "openai" }
] -%}
{%- set balanceFig = "balance-check" | figure(exports) -%}
{%- set mainLine = [
  { id: "game", t: "blk", b: "Game and plugin", s: "event types" },
  { id: "listener", t: "blk", b: "Listener", s: "localhost TCP" },
  { id: "raw", t: "blk", b: "Raw JSONL", s: "append-only" },
  { id: "seq", t: "brk", b: "seq audit" },
  { id: "parquet", t: "blk", b: "Parquet", s: "per-type files" },
  { id: "contracts", t: "brk", b: "make contracts", low: true },
  { id: "dbt", t: "blk", w: "1.4", b: "dbt models", s: "stg / int / marts", db: true },
  { id: "tests", t: "brk", b: "dbt tests", db: true },
  { id: "publish", t: "blk", w: "1.2", b: "make publish", s: "candidate file", db: true },
  { id: "audit", t: "brk", b: "publish audit", db: true },
  { id: "warehouse", t: "blk", w: "1.4", b: "Published warehouse", s: "read-only DuckDB file", db: true }
] -%}
{%- set branchLine = [
  { id: "export", t: "blk", b: "Site export", s: "JSON files" },
  { id: "xcheck", t: "brk", b: "export check" },
  { id: "page", t: "blk", b: "This page", s: "reads the export" }
] -%}
{%- set faults = [
  { id: "listener", gl: "Absorbed by" }, { id: "seq" }, { id: "unknown" }, { id: "contract" },
  { id: "registry" }, { id: "books" }, { id: "publish" }, { id: "export" }
] -%}
{#- A line is two macros because Nunjucks cannot run a story-passage shortcode inside a macro: the list's grid columns and its items. -#}
{%- macro columns(items) -%}
{%- for it in items -%}{{ ("76px" if it.low else "36px") if it.t == "brk" else ((it.w or "1") + "fr") }}{{ " " if not loop.last }}{%- endfor -%}
{%- endmacro -%}
{%- macro blocks(items) -%}
{%- for it in items %}
  <li class="{{ it.t }}{% if it.db %} in-db{% endif %}{% if it.low %} low{% endif %}" data-id="{{ it.id }}" data-state="clear" data-label="{{ it.b }}{% if it.s %}, {{ it.s }}{% endif %}{% if it.db %} (in DuckDB){% endif %}" aria-label="{{ it.b }}{% if it.s %}, {{ it.s }}{% endif %}{% if it.db %} (in DuckDB){% endif %}: clear">
    {%- if it.t == "blk" %}<span class="lamp" aria-hidden="true"></span><span class="tie" aria-hidden="true"></span><div class="node" aria-hidden="true"><b>{{ it.b }}</b><small>{{ it.s }}</small><span class="st st-clear">clear</span></div>
    {%- else %}<span class="bar" aria-hidden="true"></span><span class="lamp" aria-hidden="true"></span><span class="brk-l" aria-hidden="true">{{ it.b }}</span>{% endif %}
    {%- if not loop.last and items[loop.index0 + 1].t == "blk" %}<span class="arrowhead" aria-hidden="true"></span>{% endif %}
  </li>
{%- endfor %}
{%- endmacro -%}
