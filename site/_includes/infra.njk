<section class="sec col" id="infra" aria-labelledby="infra-h" data-spy>
  <div class="sec-head">
    <p class="no">No. 03</p>
    <h2 id="infra-h" tabindex="-1">{% passage "the-stack.md", "infra-h", "inline" %}</h2>
    <p class="lead">{% passage "the-stack.md", "infra-lead", "inline" %}</p>
  </div>
  <div class="trackwrap">
    <div class="track-top">
      <div>
        <h3 id="track-h">{% passage "the-stack.md", "track-h", "inline" %}</h3>
        <p>{% passage "the-stack.md", "track-intro", "inline" %}</p>
      </div>
    </div>
    <div class="track-area" id="track-area">
      <div class="encl" id="encl" aria-hidden="true"><span>{% passage "the-stack.md", "track-encl", "inline" %}</span></div>
      <div class="encl-space" aria-hidden="true"></div>
      <ol class="mainline" id="mainline" aria-label="{% passage "the-stack.md", "track-main-label", "text" %}" style="--cols:{{ columns(mainLine) }}">{{ blocks(mainLine) }}</ol>
      <div class="spur" id="spur">
        <p class="spur-h">{% passage "the-stack.md", "track-spur-h", "inline" %}</p>
        <span class="spur-drop" id="spur-drop" aria-hidden="true"></span>
        <aside class="recon" id="recon" aria-labelledby="recon-h">
          <span class="stamp" aria-hidden="true">checked</span>
          <div>
            <div class="recon-top"><p class="recon-k">{% passage "the-stack.md", "recon-kicker", "inline" %}</p><button class="recon-more" type="button" aria-expanded="false" aria-controls="recon-full"><span data-more="show">{% passage "the-stack.md", "recon-show", "inline" %}</span><span data-more="hide" hidden>{% passage "the-stack.md", "recon-hide", "inline" %}</span></button></div>
            <h4 id="recon-h">{% passage "the-stack.md", "recon-h", "inline" %}</h4>
            <p>{% passage "the-stack.md", "recon-lead", "inline" %}</p>
            <div class="recon-full" id="recon-full" hidden>
              <p>{% passage "the-stack.md", "recon-term", "inline" %}</p>
              <p>{% passage "the-stack.md", "recon-rule", "inline" %}</p>
              <ul class="recon-f">
                <li>{% passage "the-stack.md", "recon-first", "inline" %}</li>
                <li>{{ region(balanceFig, "div", "p") }}</li>
              </ul>
            </div>
          </div>
        </aside>
        <ol class="mainline" id="branchline" aria-label="{% passage "the-stack.md", "track-branch-label", "text" %}" style="--cols:{{ columns(branchLine) }}">{{ blocks(branchLine) }}</ol>
        <p class="spur-note">{% passage "the-stack.md", "track-note", "inline" %}</p>
      </div>
      <div class="trk-train" id="trk-train" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
    <div class="faults">
      <fieldset class="fault-pick">
        <legend>Simulate a failure</legend>
        <p class="fine">{% passage "the-stack.md", "fault-intro", "inline" %}</p>
        <div class="fault-list" id="fault-list">
          {%- for f in faults %}
          <label><input type="radio" name="fault" value="{{ f.id }}"><span>{% passage "the-stack.md", "fault-" + f.id + "-label", "inline" %}</span></label>
          {%- endfor %}
          <div class="fault-actions"><p class="fault-res" id="fault-res"><span class="lamp" data-state="clear" aria-hidden="true"></span><span><span data-res="clear">{% passage "the-stack.md", "fault-clear-res", "inline" %}</span>
            {%- for f in faults %}<span data-res="{{ f.id }}" hidden>{% passage "the-stack.md", "fault-" + f.id + "-res", "inline" %}</span>{% endfor -%}
          </span></p><button class="btn btn-p" type="button" id="fault-clear" disabled>Clear the failure</button></div>
        </div>
      </fieldset>
      <div class="callout" id="callout" data-state="clear" aria-live="polite">
        <div class="callout-h" data-panel="clear"><span class="lamp" data-state="clear" aria-hidden="true"></span><div><h4>All blocks clear</h4><p class="fine">{% passage "the-stack.md", "callout-clear-sub", "inline" %}</p></div></div>
        <dl data-panel="clear">
          <div class="guard"><dt>{% passage "the-stack.md", "callout-clear-guard-h", "inline" %}</dt><dd>{% passage "the-stack.md", "callout-clear-guard", "inline" %}</dd></div>
          <div><dt>What readers see</dt><dd>{% passage "the-stack.md", "callout-clear-reader", "inline" %}</dd></div>
        </dl>
        {%- for f in faults %}
        <div class="callout-h" data-panel="{{ f.id }}" hidden><span class="lamp" data-state="fault" aria-hidden="true"></span><div><h4>{% passage "the-stack.md", "fault-" + f.id + "-h", "inline" %}</h4><p class="fine">{% passage "the-stack.md", "fault-" + f.id + "-sub", "inline" %}</p></div></div>
        <dl data-panel="{{ f.id }}" hidden>
          <div class="guard"><dt>{{ f.gl or "Caught by" }}</dt><dd>{% passage "the-stack.md", "fault-" + f.id + "-guard", "inline" %}</dd></div>
          <div><dt>What keeps running</dt><dd>{% passage "the-stack.md", "fault-" + f.id + "-keeps", "inline" %}</dd></div>
          <div><dt>What readers see</dt><dd>{% passage "the-stack.md", "fault-" + f.id + "-reader", "inline" %}</dd></div>
        </dl>
        {%- endfor %}
      </div>
    </div>
  </div>

  <div class="stack-block">
    <h3>The data stack</h3>
    <p class="fine measure">{% passage F, "stack-lead", "inline" %}</p>
    <div class="stack-wrap">
      <div class="board"><ul id="board" aria-label="{% passage F, 'board-aria', 'text' %}">
        <li><button type="button" class="whole" aria-pressed="true" aria-controls="tool-whole" data-band=""><span>The whole stack</span><span>all seven bands</span></button></li>
        {%- for band in bands %}
        <li class="band lit" data-band="{{ band.id }}"><p class="band-h" id="band-{{ band.id }}">{{ band.title }}</p><ul aria-labelledby="band-{{ band.id }}">
          {%- for tool in tools %}{% if tool.band == band.id %}
          <li><button type="button"{% if tool.plan %} class="plan"{% endif %} aria-pressed="false" aria-controls="tool-{{ tool.id }}" data-band="{{ band.id }}"><span>{{ tool.name }}</span><span>{{ tool.role }}</span></button></li>
          {%- endif %}{% endfor %}
        </ul></li>
        {%- endfor %}
      </ul></div>
      <aside class="explain" id="explain" aria-live="off" aria-label="{% passage F, 'explain-aria', 'text' %}" data-whole="true">
        <div class="tool" id="tool-whole">
          <div class="explain-h"><div class="explain-t"><p class="explain-k">{% passage F, "whole-cat", "inline" %}</p><p class="explain-n">The whole stack</p></div></div>
          <div class="perf-x"><span class="notch n-l" aria-hidden="true"></span><span class="notch n-r" aria-hidden="true"></span></div>
          <div class="explain-b"><dl class="explain-d">
            {%- for band in bands %}{% set names = [] %}{% for tool in tools %}{% if tool.band == band.id %}{% set _ = names.push(tool.name) %}{% endif %}{% endfor %}
            <div><dt>{{ band.title }}</dt><dd>{{ names | join(", ") }}. {% passage F, "band-" + band.id, "inline" %}</dd></div>
            {%- endfor %}
          </dl></div>
        </div>
        {%- for tool in tools %}
        <div class="tool" id="tool-{{ tool.id }}" hidden>
          <div class="explain-h">
            <span class="explain-logo" aria-hidden="true">{% if tool.icon %}<svg viewBox="0 0 24 24"><use href="#i-tool-{{ tool.icon }}"/></svg>{% else %}<span class="badge">{{ tool.badge }}</span>{% endif %}</span>
            <div class="explain-t"><p class="explain-k">{% for band in bands %}{% if band.id == tool.band %}{{ band.title }}{% endif %}{% endfor %}{% if tool.plan %}, planned{% endif %}</p><p class="explain-n">{{ tool.name }}</p></div>
          </div>
          <div class="perf-x"><span class="notch n-l" aria-hidden="true"></span><span class="notch n-r" aria-hidden="true"></span></div>
          <div class="explain-b">
            <div class="explain-d">
              {%- passage F, "tool-" + tool.id %}
              {%- if tool.id == "odcs" %}
              <p>{{ contracts.count }} {% passage F, "contracts-share", "inline" %} {{ contracts.version }}.</p>
              {%- endif %}
            </div>
            <p class="explain-s{% if tool.plan %} plan{% endif %}"><span class="hole" aria-hidden="true"></span><span>{% if tool.plan %}{% passage F, "status-planned", "inline" %}{% else %}{% passage F, "status-used", "inline" %}{% endif %}</span></p>
          </div>
        </div>
        {%- endfor %}
      </aside>
    </div>
  </div>
  {% include "evidence.njk" %}
</section>
