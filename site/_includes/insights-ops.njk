{%- from "figure.njk" import figure as region -%}
{%- from "panel-table.njk" import panelTable -%}
<div class="dnote">{{ region("note-ops" | figure(exports), "div", "p") }}</div>
<div class="view-body">
  {%- set panels = [
    { id: "ops-availability", desc: true },
    { id: "ops-waits", desc: true },
    { id: "ops-riders", desc: true, note: "riders-note" },
    { id: "ops-guardrails", desc: false }
  ] %}
  {%- for panel in panels %}
  <div class="panel">
    {%- set fig = panel.id | figure(exports) %}
    {%- if fig.cells %}
    {% call region(fig) %}{{ panelTable(fig) }}{% endcall %}
    {%- else %}
    {{ region(fig) }}
    {%- endif %}
    {%- if panel.desc %}
    <p class="cap">{% passage "the-analytics-strategy.md", panel.id + "-desc", "inline" %}</p>
    {%- endif %}
    {%- if panel.note %}
    <p class="cap">{% passage "the-analytics-strategy.md", panel.note, "inline" %}</p>
    {%- endif %}
  </div>
  {%- endfor %}
</div>
<p class="gapl">{% passage "the-analytics-strategy.md", "ops-gap", "inline" %}</p>
